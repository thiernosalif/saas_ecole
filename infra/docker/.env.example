# infra/docker/.env.example
#
# Variables consommées par infra/docker/docker-compose.yml (substitution
# ${...}) — distinct du .env Laravel à la racine du repo. Copier en
# infra/docker/.env avant `docker compose -f infra/docker/docker-compose.yml up`.

# Clé de chiffrement Laravel pour l'environnement Docker — générer avec
# `php artisan key:generate --show` (ou `php -r "echo 'base64:'.base64_encode(random_bytes(32));"`).
# Distincte de l'APP_KEY du .env racine utilisé pour le dev host.
APP_KEY=

DB_USER=saas_ecole
DB_PASSWORD=change-me

REDIS_PASSWORD=change-me

MINIO_USER=saas_ecole
MINIO_PASSWORD=change-me-too
