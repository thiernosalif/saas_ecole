APP_NAME="SaaS École"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://plateforme.sn.localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Multi-tenant — résolution par sous-domaine (cf. PROJET_LARAVEL.md §3.2)
# --------------------------------------------------------------------------
# Domaine racine de la plateforme : https://{tenant}.plateforme.sn en prod,
# https://{tenant}.plateforme.sn.localhost en local (docker-compose, nginx).
TENANT_CENTRAL_DOMAIN=plateforme.sn.localhost
ADMIN_SUBDOMAIN=admin.plateforme.sn.localhost

# --------------------------------------------------------------------------
# Base de données — PostgreSQL 16 (cf. §2.4)
# --------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=saas_ecole
DB_USERNAME=saas_ecole
DB_PASSWORD=

# --------------------------------------------------------------------------
# Session (portail Blade/Livewire) — cookie partagé entre sous-domaines écoles
# --------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.plateforme.sn.localhost

# --------------------------------------------------------------------------
# Sanctum — session web (portail) + token API (mobile Flutter) (cf. §2.3)
# --------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=plateforme.sn.localhost,*.plateforme.sn.localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=saas_ecole

MEMCACHED_HOST=127.0.0.1

# --------------------------------------------------------------------------
# Redis 7 — cache, sessions Sanctum, driver de la queue (cf. §2.4)
# --------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------------------------------
# Mail — SendGrid / SMTP (cf. §2.6)
# --------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@plateforme.sn"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Stockage objets — MinIO (S3-compatible), via Flysystem S3 driver (cf. §2.5)
# --------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=saas-ecole
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --------------------------------------------------------------------------
# Laravel Horizon — dashboard jobs/queues (protégé par rôle SUPER_ADMIN)
# --------------------------------------------------------------------------
HORIZON_DOMAIN=null
HORIZON_PATH=horizon

# --------------------------------------------------------------------------
# Paiements — Wave / Orange Money (Sénégal) (cf. §2.6)
# --------------------------------------------------------------------------
WAVE_API_KEY=
WAVE_API_SECRET=
WAVE_WEBHOOK_SECRET=
WAVE_BASE_URL=https://api.wave.com

ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/sn/v1

# --------------------------------------------------------------------------
# Stripe + laravel/cashier — abonnement SaaS des écoles (cf. §2.6)
# --------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=xof
CASHIER_CURRENCY_LOCALE=fr_FR

# --------------------------------------------------------------------------
# SMS — Orange SMS API / Twilio (cf. §2.6)
# --------------------------------------------------------------------------
SMS_DRIVER=orange
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=
ORANGE_SMS_BASE_URL=https://api.orange.com/smsmessaging/v1

TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --------------------------------------------------------------------------
# Firebase Cloud Messaging — push mobile (parents, profs) (cf. §2.6)
# --------------------------------------------------------------------------
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FIREBASE_PROJECT_ID=

VITE_APP_NAME="${APP_NAME}"
